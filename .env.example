# Copy this file to .env (cp .env.example .env) and adjust if needed.
#
# Port the server listens on. Client and server must agree in dev mode:
# the Vite dev server proxies API/socket requests to this port.
PORT=3000

# Host interface to bind to.
# 0.0.0.0 = every interface (your phone can connect via the laptop's Wi-Fi IP).
# To bind only to a specific interface use e.g. 192.168.1.10.
HOST=0.0.0.0

# Optional simple shared access key. If set, every client must enter this key
# once (stored in the browser). Leave empty for open access on your trusted network.
# AUTH_TOKEN=